{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "transcribe-window",
  "description": "Voice V1 single-window transcription: start/stop, live text, copy, export. Reuses settings + session IPC.",
  "windows": ["transcribe"],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-emit",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "dialog:allow-save",
    "app-transcribe"
  ]
}
